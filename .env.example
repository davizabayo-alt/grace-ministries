NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://church_app:replace-with-db-password@127.0.0.1:5432/church
SESSION_SECRET=replace-with-a-long-random-value
JWT_SECRET=replace-with-a-different-long-random-value
SEED_SECRET=replace-with-a-third-long-random-value
NEXT_PUBLIC_SITE_URL=https://yourchurch.org
ADMIN_EMAIL=admin@yourchurch.org
ADMIN_PASSWORD=replace-before-seeding

# ---------------------------------------------------------------------------
# Database driver selection
# ---------------------------------------------------------------------------
# Oracle Cloud uses the regular PostgreSQL driver:
# DB_DRIVER=pg

# ---------------------------------------------------------------------------
# Optional split-deployment settings
# ---------------------------------------------------------------------------
# Comma-separated allow list when the frontend and API are on different origins.
# Leave unset when the public site and API share one origin.
# ALLOWED_ORIGINS=https://www.yourchurch.org

# Set to 1 when the admin portal is served from a different site than the API,
# so the session cookie uses SameSite=None; Secure.
# COOKIE_CROSS_SITE=

# Cloudflare Turnstile (optional; recommended if you use Cloudflare protection).
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
